# docker-compose.override.yml.example
#
# PURPOSE: Add local-only services that extend the base docker-compose.clean.yml.
# Docker Compose automatically merges this file with docker-compose.yml when
# you run `docker compose up` — no extra flags needed.
#
# SETUP: Copy this file to docker-compose.override.yml (gitignored):
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# Then uncomment and configure the services you need.
# Your local additions stay local — docker-compose.override.yml is gitignored.
#
# See: https://docs.docker.com/compose/multiple-compose-files/merge/

