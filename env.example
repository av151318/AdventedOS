# ProxyApp Configuration
# Copy this file to .env and fill in your values

# API Key for internal service communication
# Generate a secure random key for production
PROXYAPP_API_KEY=your-secure-api-key-here

# If you only set OPENAI_API_KEY (e.g. OpenWebUI), proxy/start_proxy.sh will copy it to PROXYAPP_API_KEY.
# OPENAI_API_KEY=your-secure-api-key-here

# Proxy Platform URL (used by Docker services to reach the proxy)
PROXYAPP_URL=http://host.docker.internal:52415

# vLLM Base URL (for OpenWebUI backend configuration)
VLLM_BASE_URL=http://localhost:52415/v1

# Heavy-lane admission circuit (Docker owns container restart; proxy gates long-context traffic only)
# PROXY_CIRCUIT_MIN_FAILS=2
# PROXY_CIRCUIT_DEBOUNCE_SECONDS=35
# Legacy alias: PROXY_CIRCUIT_HEAVY_FAIL_STREAK (used if PROXY_CIRCUIT_MIN_FAILS unset)

# Idle time between upstream SSE chunks before declaring stall (Phase 2; verify vs healthy logs before merge)
# PROXY_STREAM_IDLE_TIMEOUT_SECONDS=45

# OpenCode Zen API Key (required for OpenCode CLI integration)
OPENCODE_ZEN_API_KEY=your-zen-api-key-here
