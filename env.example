# ProxyApp Configuration
# Copy this file to .env and fill in your values

# API Key for internal service communication
# Generate a secure random key for production
PROXYAPP_API_KEY=your-secure-api-key-here

# Proxy Platform URL (used by Docker services to reach the proxy)
PROXYAPP_URL=http://host.docker.internal:52415

# vLLM Base URL (for OpenWebUI backend configuration)
VLLM_BASE_URL=http://localhost:52415/v1

# OpenCode Zen API Key (required for OpenCode CLI integration)
OPENCODE_ZEN_API_KEY=your-zen-api-key-here
